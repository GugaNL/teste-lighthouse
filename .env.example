# Variáveis do docker-compose.yml (todas opcionais — os valores abaixo são os padrões).
# As variáveis de cada aplicação ficam em backend/.env.example e frontend/.env.example.

# Porta do host onde a aplicação fica exposta (http://localhost:4008).
APP_PORT=4008

# Origens liberadas no CORS da API (* = qualquer uma).
CORS_ORIGIN=*

# true = cria o catálogo de demonstração na primeira subida, se o banco estiver vazio.
SEED_ON_START=true
