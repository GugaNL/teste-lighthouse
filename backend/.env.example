# Porta HTTP da API (o frontend em dev faz proxy para ela).
PORT=4008

# development | production | test
NODE_ENV=development

# MongoDB. Em dev, `npm run db` sobe um local nesta porta sem instalar nada.
# Com Docker, o docker-compose.yml já aponta para o serviço "mongo".
MONGO_URL=mongodb://127.0.0.1:27022/catalogo-produtos

# Origens liberadas no CORS (separadas por vírgula) ou * para qualquer uma.
# Só importa se o frontend for servido de outro domínio; em dev o Vite faz proxy.
CORS_ORIGIN=*

# true = cria o catálogo de demonstração na subida, SE a coleção estiver vazia
# (nunca apaga nada). Para recriar do zero: `npm run seed`.
SEED_ON_START=true
