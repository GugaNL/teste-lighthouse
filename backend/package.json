{
  "name": "catalogo-produtos-backend",
  "version": "1.0.0",
  "description": "Catálogo de Produtos — API REST de gerenciamento de catálogo de produtos",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "db": "node scripts/db.js",
    "seed": "node scripts/seed.js",
    "dev": "nodemon src/server.js --ignore __tests__",
    "start": "node src/server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --runInBand --coverage",
    "test:api": "npx -y newman@6 run docs/postman_collection.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write src __tests__ scripts eslint.config.js",
    "format:check": "prettier --check src __tests__ scripts eslint.config.js"
  },
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "mongoose": "^8.9.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "maxWorkers": 1,
    "testTimeout": 60000,
    "coverageThreshold": {
      "global": {
        "statements": 88,
        "branches": 80,
        "functions": 85,
        "lines": 88
      }
    }
  }
}
