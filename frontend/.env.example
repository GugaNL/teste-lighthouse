# URL base da API. Deixe vazio para usar o mesmo host do site:
#  - em dev o Vite faz proxy de /products, /categories... para a porta 4008;
#  - em produção o próprio backend serve este frontend.
# Preencha só se o frontend for hospedado separado da API
# (ex.: VITE_API_URL=https://api.meudominio.com.br — e libere a origem no
# CORS_ORIGIN do backend).
VITE_API_URL=

# Só para o servidor de dev: para onde o proxy do Vite encaminha a API.
VITE_PROXY_TARGET=http://localhost:4008
